{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/record.js\"",
            "timeout": 10,
            "statusMessage": "Saving conversation event locally"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/record.js\"",
            "timeout": 10,
            "statusMessage": "Saving tool activity locally"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/record.js\"",
            "timeout": 10,
            "statusMessage": "Saving assistant response locally"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/record.js\"",
            "timeout": 10,
            "statusMessage": "Saving subagent activity locally"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/record.js\"",
            "timeout": 3,
            "statusMessage": "Archiving session transcript locally"
          }
        ]
      }
    ]
  }
}
