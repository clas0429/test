rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed data models
    // ===============================================================
    // users/{userId}/todos/{todoId}
    //   title: string, 1–200 characters (required)
    //   done: bool (required)
    //   priority: string, high | normal | low (required)
    //   dueDate: string, empty or YYYY-MM-DD (required)
    //   category: string, 0–30 characters (required)
    //   updatedAt: integer milliseconds since epoch (required)
    //
    // users/{userId}/events/{eventId}
    //   title: string, 1–120 characters (required)
    //   date: string in YYYY-MM-DD form (required; calendar date)
    //   startTime, endTime: empty or HH:mm strings (required)
    //   location: string, 0–100 characters (required)
    //   notes: string, 0–500 characters (required)
    //   updatedAt: integer milliseconds since epoch (required)
    //
    // Both collections are private to the authenticated user in their path.

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data)
        || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data)
        || request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    function isValidTodo(data) {
      return hasRequiredFields(data, ['title', 'done', 'priority', 'dueDate', 'category', 'updatedAt'])
        && hasOnlyAllowedFields(data, ['title', 'done', 'priority', 'dueDate', 'category', 'updatedAt'])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.done is bool
        && data.priority in ['high', 'normal', 'low']
        && data.dueDate is string
        && data.dueDate.matches('^([0-9]{4}-[0-9]{2}-[0-9]{2})?$')
        && data.category is string
        && data.category.size() <= 30
        && data.updatedAt is int
        && data.updatedAt >= 0;
    }

    function isValidTime(value) {
      return value is string
        && (value == '' || value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'));
    }

    function isValidEvent(data) {
      return hasRequiredFields(data, ['title', 'date', 'startTime', 'endTime', 'location', 'notes', 'updatedAt'])
        && hasOnlyAllowedFields(data, ['title', 'date', 'startTime', 'endTime', 'location', 'notes', 'updatedAt'])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 120
        && data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isValidTime(data.startTime)
        && isValidTime(data.endTime)
        && data.location is string
        && data.location.size() <= 100
        && data.notes is string
        && data.notes.size() <= 500
        && data.updatedAt is int
        && data.updatedAt >= 0;
    }

    match /users/{userId}/todos/{todoId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidTodo(request.resource.data)
        && uidUnchanged();
      allow update: if isOwner(userId)
        && isValidTodo(request.resource.data)
        && uidNotModified();
    }

    match /users/{userId}/events/{eventId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidEvent(request.resource.data)
        && uidUnchanged();
      allow update: if isOwner(userId)
        && isValidEvent(request.resource.data)
        && uidNotModified();
    }

    // Deny all paths that are not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

